{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "glide",
  "version": "0.3.0",
  "identifier": "in.zetalabs.glide",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "glide",
        "width": 1040,
        "height": 720,
        "minWidth": 820,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}